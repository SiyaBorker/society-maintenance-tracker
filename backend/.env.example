# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Database -----------------------------------------------------------
# PostgreSQL connection string. Works with Neon, Supabase, Render Postgres,
# Railway, or a local Postgres instance.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/society_tracker?schema=public"

# --- Auth -----------------------------------------------------------------
# Any long random string. Generate one with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Optional: anyone who supplies this code on /api/auth/register is created
# as an ADMIN instead of a RESIDENT. Set to something private/hard to guess,
# or leave blank and use `npm run seed` to create the first admin instead.
ADMIN_SIGNUP_CODE="change-me-admin-code"

# --- Server -----------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins, or * for any origin.
CORS_ORIGIN="http://localhost:5173"

# --- Cloudinary (complaint photo uploads) ------------------------------
# Free account: https://cloudinary.com/users/register/free
# All three values are on your Cloudinary dashboard home page.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# --- Email (Resend) -------------------------------------------------------
# Free account: https://resend.com/signup — API key is on the dashboard.
# Raw SMTP (Gmail/Nodemailer) doesn't work on Render's free tier, which
# blocks outbound SMTP ports (25/465/587) entirely — Resend sends over
# plain HTTPS instead. See README.md for setup + domain verification.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Must be an address on a domain you've verified with Resend (or
# "onboarding@resend.dev" for testing — but that can only send to your own
# Resend account email, not to residents).
EMAIL_FROM="Society Maintenance Tracker <notifications@yourdomain.com>"

# --- Business rules -------------------------------------------------------
# Default overdue threshold (days) used the first time the app runs, before
# an admin changes it via PATCH /api/settings.
DEFAULT_OVERDUE_THRESHOLD_DAYS=7

# --- Seed script (npm run seed) ------------------------------------------
SEED_ADMIN_PASSWORD="Admin@123"
SEED_RESIDENT_PASSWORD="Resident@123"
